{
  "name": "calmboard",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev-all.mjs web",
    "dev:api": "node scripts/dev-all.mjs api",
    "dev:worker": "node scripts/dev-all.mjs worker",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "cross-env NODE_ENV=production turbo build --filter=@calmboard/web --filter=@calmboard/api --filter=@calmboard/worker --filter=@calmboard/types --filter=@calmboard/database --filter=@calmboard/config --filter=@calmboard/notifications --filter=@calmboard/validation --filter=@calmboard/api-client --filter=@calmboard/licensing",
    "build:web": "pnpm --filter @calmboard/web build",
    "start": "pnpm --filter @calmboard/web start",
    "start:api": "pnpm --filter @calmboard/api start",
    "start:worker": "pnpm --filter @calmboard/worker start",
    "prepare": "husky",
    "check:env": "node scripts/check-env.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:cycles": "node scripts/check-circular-dependencies.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "db:check": "node scripts/database-command.mjs check",
    "db:generate": "node scripts/database-command.mjs generate",
    "db:migrate": "node scripts/database-command.mjs migrate",
    "db:migrate:status": "node scripts/database-command.mjs migrate --check",
    "db:backup:local": "node scripts/local-db-recovery.mjs",
    "db:baseline:dev": "node scripts/adopt-development-baseline.mjs",
    "db:migrate:verify": "node scripts/verify-empty-migration.mjs",
    "ci:verify-empty": "node scripts/verify-empty-migration.mjs --ci",
    "db:migrate:verify-current": "node scripts/verify-current-migration.mjs",
    "db:push": "node scripts/database-command.mjs push",
    "db:seed:dev": "tsx --env-file=.env scripts/seed-dev.ts",
    "db:studio": "node scripts/database-command.mjs studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typegen": "pnpm --filter @calmboard/web typegen",
    "lint": "turbo lint --filter=@calmboard/web --filter=@calmboard/api --filter=@calmboard/worker --filter=@calmboard/types --filter=@calmboard/database --filter=@calmboard/config --filter=@calmboard/notifications --filter=@calmboard/validation --filter=@calmboard/api-client --filter=@calmboard/licensing",
    "typecheck": "turbo typecheck --filter=@calmboard/web --filter=@calmboard/api --filter=@calmboard/worker --filter=@calmboard/types --filter=@calmboard/database --filter=@calmboard/config --filter=@calmboard/notifications --filter=@calmboard/validation --filter=@calmboard/api-client --filter=@calmboard/licensing",
    "test": "node --test scripts/*.test.mjs && turbo test --filter=@calmboard/web --filter=@calmboard/api --filter=@calmboard/worker --filter=@calmboard/types --filter=@calmboard/database --filter=@calmboard/config --filter=@calmboard/notifications --filter=@calmboard/validation --filter=@calmboard/api-client --filter=@calmboard/licensing",
    "test:integration": "pnpm run check:env && pnpm --filter @calmboard/database test:integration && pnpm --filter @calmboard/api test:integration",
    "test:migrations": "node --test scripts/integration/migration-runner.test.mjs",
    "test:e2e": "pnpm --filter @calmboard/web test:e2e",
    "quality": "node scripts/quality-gate.mjs",
    "ci": "pnpm run quality && pnpm run test && pnpm run build",
    "turbo:build": "pnpm run build",
    "turbo:lint": "pnpm run lint",
    "turbo:typecheck": "pnpm run typecheck"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,css,md,yml,yaml}": [
      "prettier --check"
    ],
    "apps/web/**/*.{ts,tsx,js,mjs,cjs}": [
      "pnpm --dir apps/web exec eslint"
    ]
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.4",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "5.9.3",
    "wait-on": "9.5.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/node-cpu-profiler",
      "@sentry/cli",
      "argon2",
      "esbuild",
      "msgpackr-extract",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "@grpc/grpc-js@>=1.14.0 <1.14.5": "1.14.5",
      "@opentelemetry/api": "1.9.1",
      "@sentry/bundler-plugins>glob@>=9.0.0 <=14.0.1": "14.0.2",
      "@typescript-eslint/typescript-estree>minimatch@>=7.0.0 <11.0.1": "11.0.1",
      "axios@<1.20.0": "1.20.0",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
      "engine.io@<6.6.10": "6.6.10",
      "esbuild@<=0.24.2": "0.25.0",
      "fast-copy@<4.1.0": "4.1.0",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "fast-uri@>=4.0.0 <4.2.3": "4.2.3",
      "fastify@<5.12.7": "5.12.7",
      "find-my-way@<=9.6.0": "9.7.0",
      "follow-redirects@<1.16.2": "1.16.2",
      "joi@<18.3.1": "18.3.1",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<8.5.23": "8.5.23",
      "prosemirror-view@<1.42.3": "1.42.3",
      "rimraf>glob@>=9.0.0 <=14.0.1": "14.0.2",
      "sharp@<0.35.5": "0.35.5",
      "source-map-js@<1.2.2": "1.2.2",
      "uuid@<11.1.1": "11.1.1"
    }
  }
}
