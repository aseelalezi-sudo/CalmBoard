# Copy this file outside the repository, fill it there, and encrypt it with
# deploy/setup.sh. Never store the plaintext file or an age private key here.
POSTGRES_USER=calmboard_admin
POSTGRES_PASSWORD=replace-with-a-random-secret
POSTGRES_DB=calmboard
POSTGRES_APP_USER=calmboard_app
POSTGRES_APP_PASSWORD=replace-with-a-different-random-secret
POSTGRES_MAINTENANCE_USER=calmboard_maintenance
POSTGRES_MAINTENANCE_PASSWORD=replace-with-another-random-secret
MINIO_ROOT_USER=replace-with-a-random-access-key
MINIO_ROOT_PASSWORD=replace-with-a-random-secret
APP_URL=https://staging.example.com
AUTH_COOKIE_SECURE=true
API_PUBLIC_URL=https://api.staging.example.com
S3_PUBLIC_ENDPOINT=https://objects.staging.example.com
TRUST_PROXY_HOPS=1
# Required production scanner. Keep the token in the external secret store.
ATTACHMENT_SCAN_MODE=webhook
ATTACHMENT_SCANNER_URL=https://scanner.staging.example.com/scan
ATTACHMENT_SCANNER_TOKEN=replace-with-a-random-scanner-token
TURNSTILE_SITE_KEY=replace-with-the-public-site-key
TURNSTILE_SECRET_KEY=replace-with-the-secret-key
TURNSTILE_EXPECTED_HOSTNAMES=staging.example.com
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-bytes
WEBHOOK_SIGNING_SECRET=replace-with-a-random-secret
INTEGRATION_CREDENTIALS_KEY=replace-with-a-base64-encoded-32-byte-key
MFA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
AUTH_EMAIL_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Lifecycle requests require an approved grace value and policy version.
# No example duration is supplied because this is a product/policy decision.
DATA_LIFECYCLE_ENABLED=false
DATA_DELETION_GRACE_HOURS=
DATA_LIFECYCLE_POLICY_VERSION=
ORGANIZATION_PURGE_ENABLED=false
DATA_RETENTION_CLASSIFICATIONS_JSON=
STRIPE_PURGE_MODE=disabled
STRIPE_LIVE_PURGE_ENABLED=false
RESEND_API_KEY=
SENTRY_DSN=
METRICS_BEARER_TOKEN=replace-with-at-least-32-random-bytes

# Immutable images built from the same commit SHA.
CALMBOARD_WEB_IMAGE=registry.example/calmboard-web:replace-with-commit-sha
CALMBOARD_API_IMAGE=registry.example/calmboard-api:replace-with-commit-sha
CALMBOARD_MIGRATIONS_IMAGE=registry.example/calmboard-migrations:replace-with-commit-sha
CALMBOARD_WORKER_IMAGE=registry.example/calmboard-worker:replace-with-commit-sha

# Absolute host path to a file containing only METRICS_BEARER_TOKEN.
METRICS_BEARER_TOKEN_FILE=/run/secrets/calmboard-metrics-token

# Absolute host path to a protected Alertmanager configuration with real receivers.
ALERTMANAGER_CONFIG_FILE=/run/secrets/calmboard-alertmanager.yml

# Backup encryption and an independent S3/MinIO destination.
# Keep AGE_PRIVATE_KEY_FILE outside the repository and expose it only to restore jobs.
AGE_RECIPIENT=age1replace-with-public-recipient
AGE_PRIVATE_KEY_FILE=/run/secrets/calmboard-backup-age-key
BACKUP_S3_ENDPOINT=https://replace-with-independent-backup-storage
BACKUP_S3_ACCESS_KEY_ID=replace-with-backup-only-access-key
BACKUP_S3_SECRET_ACCESS_KEY=replace-with-backup-only-secret
BACKUP_S3_BUCKET=calmboard-backups
BACKUP_RETENTION_DAYS=30
