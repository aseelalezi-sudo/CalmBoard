{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "ALLOW_DEV_SEED",
    "AUTH_EMAIL_BATCH_SIZE",
    "AUTH_EMAIL_CLAIM_TIMEOUT_MINUTES",
    "AUTH_EMAIL_ENCRYPTION_ACTIVE_KEY_VERSION",
    "AUTH_EMAIL_ENCRYPTION_KEY",
    "AUTH_EMAIL_ENCRYPTION_KEYS",
    "AUTH_EMAIL_INTERVAL_MS",
    "AUTOMATION_EVENT_BATCH_SIZE",
    "FORM_SUBMISSION_BATCH_SIZE",
    "FORM_SUBMISSION_CLAIM_TIMEOUT_MINUTES",
    "STRIPE_GRACE_PERIOD_DAYS",
    "BILLING_GRACE_PERIOD_INTERVAL_MS",
    "BILLING_GRACE_PERIOD_BATCH_SIZE",
    "FORM_SUBMISSION_INTERVAL_MS",
    "AUTOMATION_EVENT_CLAIM_TIMEOUT_MINUTES",
    "AUTOMATION_EVENT_INTERVAL_MS",
    "WORKSPACE_EXPORT_BATCH_SIZE",
    "WORKSPACE_EXPORT_CLAIM_TIMEOUT_MINUTES",
    "WORKSPACE_EXPORT_INTERVAL_MS",
    "WORKSPACE_EXPORT_RETENTION_DAYS",
    "REPORT_SCHEDULE_INTERVAL_MS",
    "REPORT_SCHEDULE_BATCH_SIZE",
    "AUTH_TOKEN_SECRET",
    "APP_URL",
    "CALMBOARD_QUEUE_NAME",
    "CALMBOARD_LICENSE_SERVER_URL",
    "CALMBOARD_LICENSE_DEVICE_HASH_SECRET",
    "CALMBOARD_LICENSE_ISSUER",
    "CALMBOARD_LICENSE_PRODUCT",
    "CALMBOARD_LICENSE_KEY",
    "CALMBOARD_LICENSE_ENFORCED",
    "CALMBOARD_LICENSE_STORE_SECRET",
    "CALMBOARD_LICENSE_STORE_FILE",
    "CALMBOARD_LICENSE_GRACE_SECONDS",
    "CALMBOARD_LICENSE_REVALIDATION_SECONDS",
    "CALMBOARD_LICENSE_TIMEOUT_MS",
    "DATABASE_APP_URL",
    "DATABASE_MAINTENANCE_URL",
    "DATABASE_URL",
    "NODE_ENV",
    "NOTIFICATION_EMAIL_BATCH_SIZE",
    "NOTIFICATION_EMAIL_CLAIM_TIMEOUT_MINUTES",
    "NOTIFICATION_EMAIL_INTERVAL_MS",
    "OPENAI_API_KEY",
    "REDIS_URL",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "S3_ACCESS_KEY_ID",
    "S3_BUCKET",
    "S3_ENDPOINT",
    "S3_PUBLIC_ENDPOINT",
    "S3_REGION",
    "S3_SECRET_ACCESS_KEY",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "TRUST_PROXY_HOPS",
    "WEBHOOK_SIGNING_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
