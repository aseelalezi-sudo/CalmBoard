# CalmBoard Environment Configuration
# Copy to .env.local for local development. Never commit real secrets.

NODE_ENV=development
DEPLOY_ENV=development
PORT=3000
WORKER_HEALTH_PORT=3002
ALLOW_DEV_SEED=false

# PostgreSQL / Drizzle
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Runtime API connection. In production this must use a NOSUPERUSER/NOBYPASSRLS role;
# keep DATABASE_URL for migrations and administrative maintenance.
DATABASE_APP_URL=postgresql://app_runtime:replace-me@127.0.0.1:5432/app_db
# Dedicated privileged connection used only by maintenance workers, never by web requests.
DATABASE_MAINTENANCE_URL=postgresql://maintenance:replace-me@127.0.0.1:5432/app_db
SEARCH_PROVIDER=postgresql

# Optional Redis / BullMQ / realtime
REDIS_URL=redis://127.0.0.1:6379/0
CALMBOARD_QUEUE_NAME=calmboard-default
# Number of trusted reverse-proxy hops before the API (0 when directly exposed).
TRUST_PROXY_HOPS=0

# Optional S3-compatible object storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=calmboard-attachments
S3_ACCESS_KEY_ID=dev_minio_user
S3_SECRET_ACCESS_KEY=dev_minio_password
# Uploaded files remain unavailable until this hook returns an explicit clean verdict.
# Use disabled only for local development; production fails closed.
ATTACHMENT_SCAN_MODE=disabled
ATTACHMENT_SCANNER_URL=
ATTACHMENT_SCANNER_TOKEN=
ATTACHMENT_CLEANUP_INTERVAL_MS=900000
ATTACHMENT_PENDING_RETENTION_HOURS=2
ATTACHMENT_DELETED_RETENTION_HOURS=24
ATTACHMENT_CLEANUP_CLAIM_TIMEOUT_MINUTES=30
ATTACHMENT_CLEANUP_BATCH_SIZE=100
ATTACHMENT_CLEANUP_MAX_ATTEMPTS=10
TASK_REMINDER_INTERVAL_MS=60000
TASK_REMINDER_BATCH_SIZE=100
NOTIFICATION_EMAIL_INTERVAL_MS=30000
NOTIFICATION_EMAIL_BATCH_SIZE=50
NOTIFICATION_EMAIL_CLAIM_TIMEOUT_MINUTES=15
AUTH_EMAIL_INTERVAL_MS=15000
AUTH_EMAIL_BATCH_SIZE=25
AUTH_EMAIL_CLAIM_TIMEOUT_MINUTES=15
INVITATION_TOKEN_TTL_HOURS=168
INVITATION_EMAIL_INTERVAL_MS=15000
INVITATION_EMAIL_BATCH_SIZE=25
INVITATION_EMAIL_CLAIM_TIMEOUT_MINUTES=15
AUTOMATION_EVENT_INTERVAL_MS=10000
AUTOMATION_EVENT_BATCH_SIZE=25
FORM_SUBMISSION_INTERVAL_MS=10000
FORM_SUBMISSION_BATCH_SIZE=25
FORM_SUBMISSION_CLAIM_TIMEOUT_MINUTES=15
STRIPE_GRACE_PERIOD_DAYS=7
BILLING_GRACE_PERIOD_INTERVAL_MS=300000
BILLING_GRACE_PERIOD_BATCH_SIZE=100
AUTOMATION_EVENT_CLAIM_TIMEOUT_MINUTES=15
WORKSPACE_EXPORT_INTERVAL_MS=10000
WORKSPACE_EXPORT_BATCH_SIZE=5
WORKSPACE_EXPORT_CLAIM_TIMEOUT_MINUTES=30
WORKSPACE_EXPORT_RETENTION_DAYS=7
DATA_LIFECYCLE_ENABLED=false
# Required before enabling lifecycle requests; no legal/product duration is assumed.
DATA_DELETION_GRACE_HOURS=
DATA_LIFECYCLE_POLICY_VERSION=
ORGANIZATION_PURGE_ENABLED=false
DATA_RETENTION_CLASSIFICATIONS_JSON=
# Provider cleanup is disabled by default. Test mode accepts only Stripe test keys;
# live cleanup additionally requires the explicit live opt-in.
STRIPE_PURGE_MODE=disabled
STRIPE_LIVE_PURGE_ENABLED=false
DATA_LIFECYCLE_INTERVAL_MS=60000
DATA_LIFECYCLE_BATCH_SIZE=250
DATA_LIFECYCLE_CLAIM_TIMEOUT_MINUTES=15
DATA_LIFECYCLE_MAX_ATTEMPTS=8
DATA_LIFECYCLE_RETRY_BASE_SECONDS=30
REPORT_SCHEDULE_INTERVAL_MS=60000
REPORT_SCHEDULE_BATCH_SIZE=25

# AI Provider Adapter - configure one or both
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Required when an AI key is set. Use the provider's current USD prices per one million tokens.
AI_MODEL_PRICING_JSON={}
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Stripe Billing Adapter
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Explicit opt-in for local Stripe webhook fixtures only; never enabled in production.
ALLOW_SIMULATED_STRIPE_WEBHOOKS=false

# Resend notification and authentication delivery (required in production)
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@example.com
AUTH_EMAIL_ENCRYPTION_KEY=
AUTH_EMAIL_ENCRYPTION_ACTIVE_KEY_VERSION=1
# For rotation, provide retained versions instead of the single key:
# AUTH_EMAIL_ENCRYPTION_KEYS={"1":"base64-32-byte-key","2":"base64-32-byte-key"}

# Security / application
APP_URL=http://localhost:3000
AUTH_COOKIE_SECURE=false
API_PUBLIC_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:5500
NEXT_PUBLIC_REALTIME_URL=http://localhost:5500
WEBHOOK_SIGNING_SECRET=change-me-in-production
# Inbound integration webhook verification. Receiver URLs are created from the API.
INTEGRATION_GITHUB_WEBHOOK_SECRET=
INTEGRATION_SLACK_SIGNING_SECRET=
# Cloudflare Turnstile. Official test keys are used automatically outside production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional comma-separated hostname allowlist checked after production verification.
TURNSTILE_EXPECTED_HOSTNAMES=
# At least 32 random bytes; used only to sign short-lived access tokens.
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-bytes
# OAuth login is hidden unless its provider flag is explicitly enabled.
AUTH_GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
AUTH_MICROSOFT_OAUTH_ENABLED=false
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common

# Workspace integration OAuth. Register each callback as:
# ${API_PUBLIC_URL}/integrations/oauth/{github|slack|gcal|microsoft}/callback
INTEGRATION_GITHUB_OAUTH_ENABLED=false
INTEGRATION_GITHUB_CLIENT_ID=
INTEGRATION_GITHUB_CLIENT_SECRET=
INTEGRATION_GITHUB_SCOPES=read:user repo
INTEGRATION_SLACK_OAUTH_ENABLED=false
INTEGRATION_SLACK_CLIENT_ID=
INTEGRATION_SLACK_CLIENT_SECRET=
INTEGRATION_SLACK_SCOPES=chat:write channels:read
INTEGRATION_GOOGLE_OAUTH_ENABLED=false
INTEGRATION_GOOGLE_CLIENT_ID=
INTEGRATION_GOOGLE_CLIENT_SECRET=
INTEGRATION_GOOGLE_SCOPES=openid email profile https://www.googleapis.com/auth/calendar.events
INTEGRATION_MICROSOFT_OAUTH_ENABLED=false
INTEGRATION_MICROSOFT_CLIENT_ID=
INTEGRATION_MICROSOFT_CLIENT_SECRET=
INTEGRATION_MICROSOFT_TENANT=common
INTEGRATION_MICROSOFT_SCOPES=openid profile email offline_access User.Read Calendars.ReadWrite
# Dedicated AES-256-GCM key for TOTP secrets. Generate 32 random bytes.
MFA_ENCRYPTION_KEY=
MFA_ENCRYPTION_ACTIVE_KEY_VERSION=1
# For rotation, provide retained versions instead of the single key:
# MFA_ENCRYPTION_KEYS={"1":"base64-32-byte-key","2":"base64-32-byte-key"}
# Generate a 32-byte key, for example: openssl rand -base64 32
INTEGRATION_CREDENTIALS_KEY=
INTEGRATION_CREDENTIALS_ACTIVE_KEY_VERSION=1
# For rotation, provide all retained versions as JSON instead of the single key above:
# INTEGRATION_CREDENTIALS_KEYS={"1":"base64-32-byte-key","2":"base64-32-byte-key"}
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
ENABLE_OTEL=false
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_BEARER_TOKEN=replace-with-at-least-32-random-bytes
NEXT_PUBLIC_TELEMETRY_UI_ENABLED=false
NEXT_PUBLIC_WEBAUTHN_UI_ENABLED=false

# Docker Compose local defaults. Replace for real deployments.
POSTGRES_USER=calmboard
POSTGRES_PASSWORD=dev_postgres_password
POSTGRES_DB=calmboard_db
MINIO_ROOT_USER=dev_minio_user
MINIO_ROOT_PASSWORD=dev_minio_password

# ---- Licensing (CalmBoard SDK; optional until explicitly enforced) ----
CALMBOARD_LICENSE_ENFORCED=false
CALMBOARD_LICENSE_SERVER_URL=http://127.0.0.1:8080/api/v1
CALMBOARD_LICENSE_DEVICE_HASH_SECRET=
CALMBOARD_LICENSE_ISSUER=licensehub
CALMBOARD_LICENSE_PRODUCT=calmboard
CALMBOARD_LICENSE_KEY=
CALMBOARD_LICENSE_STORE_SECRET=
CALMBOARD_LICENSE_STORE_FILE=./license-state.enc
CALMBOARD_LICENSE_GRACE_SECONDS=604800
CALMBOARD_LICENSE_REVALIDATION_SECONDS=86400
CALMBOARD_LICENSE_TIMEOUT_MS=5000
# Organization exports use bounded relational pages and bounded cleanup batches.
ORGANIZATION_EXPORT_PAGE_SIZE=500
EXPORT_CLEANUP_BATCH_SIZE=25
