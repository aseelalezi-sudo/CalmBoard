{
  "name": "@calmboard/database",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./src/schema.ts",
      "default": "./src/schema.ts"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "import": "./src/errors.ts",
      "default": "./src/errors.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "pnpm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --env-file-if-exists=../../.env --test src/**/*.test.ts && pnpm run typecheck",
    "test:integration": "tsx --env-file-if-exists=../../.env --test integration/**/*.test.ts"
  },
  "dependencies": {
    "@calmboard/notifications": "workspace:*",
    "@calmboard/types": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.20.0"
  },
  "devDependencies": {
    "@types/pg": "8.18.0",
    "tsx": "^4.23.1"
  }
}
