{
  "name": "@calmboard/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=../../.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "pnpm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --conditions source --env-file-if-exists=../../.env --test src/**/*.test.ts && pnpm run typecheck",
    "test:integration": "tsx --conditions source --env-file-if-exists=../../.env --test integration/**/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@calmboard/database": "workspace:*",
    "@calmboard/licensing": "workspace:*",
    "@calmboard/notifications": "workspace:*",
    "@calmboard/types": "workspace:*",
    "@calmboard/validation": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/platform-socket.io": "11.2.7",
    "@nestjs/websockets": "11.2.7",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/node": "^10.76.2",
    "@sentry/profiling-node": "^10.76.2",
    "@socket.io/redis-adapter": "8.3.0",
    "@willsoto/nestjs-prometheus": "^6.1.1",
    "argon2": "0.45.1",
    "bullmq": "5.81.5",
    "drizzle-orm": "0.45.4",
    "fastify": "^5.12.7",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "socket.io-client": "4.8.4"
  }
}
