{
  "name": "@calmboard/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "pnpm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --conditions source --env-file-if-exists=../../.env --test src/**/*.test.ts && pnpm run typecheck"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@calmboard/database": "workspace:*",
    "@calmboard/notifications": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@sentry/node": "^10.76.2",
    "@sentry/profiling-node": "^10.76.2",
    "archiver": "5.3.2",
    "bullmq": "^5.81.5",
    "drizzle-orm": "0.45.4",
    "exceljs": "^4.4.0",
    "ioredis": "^5.11.1",
    "jszip": "3.10.2",
    "pdfkit": "^0.20.2",
    "pg": "8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "8.23.1",
    "pino-pretty": "^13.2.0",
    "typescript": "5.9.3"
  }
}
