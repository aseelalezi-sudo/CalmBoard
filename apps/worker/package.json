{
  "name": "@calmboard/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "pnpm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts && pnpm run typecheck"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1095.0",
    "@calmboard/database": "workspace:*",
    "@calmboard/notifications": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@sentry/node": "^10.69.0",
    "@sentry/profiling-node": "^10.69.0",
    "bullmq": "^5.81.2",
    "drizzle-orm": "0.45.2",
    "exceljs": "^4.4.0",
    "ioredis": "^5.11.1",
    "pdfkit": "^0.19.1",
    "pg": "8.20.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "8.18.0",
    "pino-pretty": "^13.1.3",
    "typescript": "5.9.3"
  }
}
